RewriteEngine On

RewriteCond %{THE_REQUEST} \s/+(.+/)?public/index\.php[?\s] [NC]
RewriteRule ^ %1 [R=301,L]

RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]